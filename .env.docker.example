# Copy to .env in this folder. Docker Compose reads it when BUILDING the web image.
# Vite inlines these values, so changing them means rebuilding: docker compose build web
#
# Everything else the API needs (Clerk secret key, Gemini, Razorpay) comes from
# backend/.env at run time.

# Where the browser reaches the API. Published by Compose on port 3000.
VITE_API_URL=http://localhost:3000

# https://dashboard.clerk.com -> API keys (the same publishable key as frontend/.env)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
