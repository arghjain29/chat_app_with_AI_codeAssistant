NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/codecollab
# Redis is optional. Without it, rate limits and caches fall back to in-memory.
# Either set a full URL (rediss:// for TLS)...
REDIS_URL=
# ...or the values from your provider's dashboard (Redis Cloud, Upstash, ...).
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=default
REDIS_PASSWORD=
# true if the provider requires TLS (Upstash always does)
REDIS_TLS=false

# https://dashboard.clerk.com -> API keys
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Clerk -> Webhooks -> endpoint /webhooks/clerk -> signing secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# AI assistant. One key is enough (free Gemini key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: Claude as an extra provider
ANTHROPIC_API_KEY=
# Optional: override the model fallback order per plan tier (provider:model, best first)
# AI_FAST_MODELS=gemini:gemini-3.5-flash-lite,gemini:gemini-3.8-flash,anthropic:claude-haiku-4-5
# AI_PREMIUM_MODELS=anthropic:claude-sonnet-5,gemini:gemini-3.1-pro-preview,gemini:gemini-3.8-flash
# Daily spending ceiling in USD across all users (safety net)
AI_DAILY_BUDGET_USD=2

# Payments (Razorpay test mode: Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
# The secret you set on the webhook (events: payment_link.paid / .expired / .cancelled, refund.processed)
RAZORPAY_WEBHOOK_SECRET=xxx
